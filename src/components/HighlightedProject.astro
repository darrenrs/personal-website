---
import GitHubIcon from "./GitHubIcon.astro";
import ProjectLicense from "./ProjectLicense.astro";
import Image from "astro/components/Image.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="highlight-card">
  <figure>
    <a class="highlight-image" href={project.href} aria-label={`Explore ${project.title}`}>
      {project.img ? (
        <Image src={project.img} alt={project.imgAlt ?? `${project.title} screenshot`} loading="lazy" />
      ) : (
        <div class="placeholder-landscape">Project image</div>
      )}
    </a>
    <figcaption>
      {project.imgLicense && <ProjectLicense license={project.imgLicense} href={project.imgSrc} />}
    </figcaption>
  </figure>
  <div class="highlight-copy">
    <h3><a href={project.href}>{project.title}</a></h3>
    {project.categories && <p class="highlight-categories">{project.categories.join(" • ")}</p>}
    <p>{project.description}</p>
  </div>
  <div class="highlight-actions">
    <a class="highlight-primary" href={project.href}>Go to project</a>
    {project.githubUrl && <a class="highlight-github" href={project.githubUrl} aria-label={`View ${project.title} on GitHub`}>GitHub <GitHubIcon /></a>}
  </div>
</article>

<style>
  .highlight-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  figure { margin: 0; }

  .highlight-image {
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 7px;
  }

  .highlight-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    min-height: 1.8rem;
    padding-top: 0.35rem;
    color: var(--muted);
    font-size: 0.75rem;
  }

  h3 { font-size: 1.35rem; line-height: 1.25; }

  .highlight-copy .highlight-categories {
    margin: 0.5rem 0 0.85rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .highlight-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .highlight-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
  }

  .highlight-github {
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--muted);
    border-radius: 7px;
    background: var(--surface);
    color: var(--text);
  }

  .highlight-github:hover {
    background: color-mix(in srgb, var(--surface), var(--bg) 35%);
    color: var(--accent);
  }

  .highlight-primary {
    padding: 0.6rem 0.95rem;
    border-radius: 7px;
    background: var(--accent);
    color: #101113;
  }

  .highlight-primary:hover {
    background: color-mix(in srgb, var(--accent), white 15%);
    color: #101113;
  }

  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
