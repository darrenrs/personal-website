---
import Layout from "../layout/Layout.astro";
import WideProject from "../components/WideProject.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Layout
  title="Portfolio | Darren R. Skidmore"
  description="Explore Darren Skidmore's personal and academic projects in data science, data engineering, interactive web applications, visualization, GIS, and machine learning."
>
  <section class="stack">
    <h1>Portfolio</h1>
    <p>
      This page showcases my personal and academic projects exploring data
      science, data engineering, and machine learning—from preparing and
      analyzing data to building interactive web applications, visualizations,
      and GIS tools.
    </p>
    <h2>Projects</h2>
    <div class="project-list">
      {projects.filter((project) => project.section === "personal").map((project) => (
        <WideProject project={project} />
      ))}
    </div>
    <h2>School Projects</h2>
    <div class="grid portfolio-grid">
      {projects.filter((project) => project.section === "academic").map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <h2>Other</h2>
    <div class="grid portfolio-grid">
      {projects.filter((project) => project.section === "other").map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</Layout>

<style>
  .project-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
</style>
