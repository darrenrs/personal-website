---
import Layout from "../layout/Layout.astro";
---

<Layout
  title="Privacy Policy | Darren R. Skidmore"
  description="Privacy Policy for darrenskidmore.com."
>
  <section class="stack">
    <h1>Privacy Policy</h1>
    <h2 id="ipip-workbench">IPIP Workbench</h2>
    <p>
      No quiz responses are collected or stored server-side; all responses are
      computed locally in the browser. In-progress quizzes and completed results
      are stored in local storage on this device. However, non-identifying
      analytics data may be collected by Cloudflare.
    </p>
  </section>
</Layout>
